# --- App ---
# Public origin of this Next.js app (used in OTP emails and absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase Postgres (Prisma) ---
# Project Settings → Database → Connection string
# DATABASE_URL: Transaction pooler (port 6543), add ?pgbouncer=true
# DIRECT_URL: Direct / session connection (port 5432) — required for prisma migrate
# If the DB password contains special characters (* ? @ #), URL-encode them
#   e.g. * → %2A   ? → %3F   @ → %40   # → %23
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Auth / sessions ---
# Random secret for signing the user session cookie and the admin cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Absolute user session lifetime in hours (from OTP verify). Not sliding.
SESSION_HOURS=6

# --- OTP delivery channel ---
# sms | email  (default: sms). Keep both values in sync.
OTP_CHANNEL=sms
NEXT_PUBLIC_OTP_CHANNEL=sms

# --- OTP codes ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Minimum seconds between OTP requests for the same contact
OTP_RESEND_SECONDS=30

# --- Admin leads popup ---
# Shared password for the Leads modal. Not an email login.
ADMIN_PASSWORD=
# How long the admin cookie lasts after a successful password (minutes)
ADMIN_SESSION_MINUTES=30

# --- GeezSMS (when OTP_CHANNEL=sms) ---
# Token from https://geezsms.com/#/api
# If empty, OTPs are printed to the server console instead
GEEZSMS_TOKEN=
# Optional shortcode id; omit to use Geez default
GEEZSMS_SHORTCODE_ID=

# --- Outbound email via Nodemailer (SMTP) — used when OTP_CHANNEL=email ---
# If SMTP_HOST / SMTP_USER / SMTP_PASS are empty, OTPs are printed to the server console instead
# Examples:
#   Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false  (use an App Password)
#   Outlook: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=false
#   SSL (465): SMTP_PORT=465  SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From address shown to recipients (should match your SMTP account / allowed sender)
EMAIL_FROM="Ankuaru <noreply@example.com>"
